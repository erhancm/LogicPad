direction: down

title: {
  label: "LogicPad — System Context"
  near: top-center
  style: {
    font-size: 28
    bold: true
  }
}

operator: "Operator" {
  shape: person
  style: {
    font-size: 16
  }
  label: "Operator\n\nUses the macro pad for typing,\nmacros, and media keys.\nEdits profiles on the OLED\nor in the optional desktop app."
}

factory: "Factory / Recovery" {
  shape: person
  style: {
    font-size: 16
  }
  label: "Factory / Recovery\n\nOne-time flash or brick\nrecovery via ST-Link."
}

pad: "LogicPad Device" {
  shape: rectangle
  style: {
    fill: "#e8f4fd"
    stroke: "#2196F3"
    font-size: 16
    border-radius: 8
  }
  label: "LogicPad Device\n\nSTM32F103C8 macro pad\n3x3 key grid, OLED, RGB LEDs\nUSB Custom HID"
}

app: "LogicPad Configurator" {
  shape: rectangle
  style: {
    fill: "#e8f4fd"
    stroke: "#2196F3"
    font-size: 16
    border-radius: 8
  }
  label: "LogicPad Configurator\n\nOptional Tauri 2 desktop app\nProfiles, macros, firmware update\nAuto profile switching"
}

osHid: "Host OS HID Stack" {
  shape: rectangle
  style: {
    fill: "#f5f5f5"
    stroke: "#9e9e9e"
    font-size: 16
    border-radius: 8
  }
  label: "Host OS HID Stack\n\nWindows / macOS / Linux\nInbox HID drivers\nNo custom kernel driver"
}

hostApps: "Host Applications" {
  shape: rectangle
  style: {
    fill: "#f5f5f5"
    stroke: "#9e9e9e"
    font-size: 16
    border-radius: 8
  }
  label: "Host Applications\n\nEditors, browsers, games\nAnything that takes\nkeyboard/mouse/media input"
}

stlink: "ST-Link Debugger" {
  shape: rectangle
  style: {
    fill: "#f5f5f5"
    stroke: "#9e9e9e"
    font-size: 16
    border-radius: 8
  }
  label: "ST-Link Debugger\n\nSWD programmer\nWrites LogicPad_factory.hex\n(bootloader + app) once"
}

operator -> pad: "Physical keys,\nSEL button, OLED menus" {
  style: {
    font-size: 13
  }
}
operator -> app: "Edit profiles,\nupdate firmware" {
  style: {
    font-size: 13
    stroke-dash: 4
  }
}
app -> pad: "Vendor HID report 4\nhidapi, VID 0483, PID 5750/5751" {
  style: {
    font-size: 13
  }
}
pad -> osHid: "Reports 1–3\nKeyboard, mouse, consumer (1 ms)" {
  style: {
    font-size: 13
  }
}
osHid -> hostApps: "Input events" {
  style: {
    font-size: 13
  }
}
factory -> stlink: "Flash once" {
  style: {
    font-size: 13
  }
}
stlink -> pad: "LogicPad_factory.hex via SWD" {
  style: {
    font-size: 13
  }
}
