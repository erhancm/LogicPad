direction: down

title: {
  label: "USB HID Path — Device and Host Layers"
  near: top-center
  style: {
    font-size: 28
    bold: true
  }
}

dev: "Device (STM32F103C8)" {
  style: {
    fill: "#e3f2fd"
    stroke: "#1565C0"
    border-radius: 12
    font-size: 18
    bold: true
  }

  appProto: "Application / Bootloader Protocol" {
    shape: rectangle
    style: {
      fill: "#bbdefb"
      stroke: "#1976D2"
      font-size: 14
      border-radius: 6
    }
    label: "Protocol Layer\nhid_reports.c or boot.c\nVendor command handlers"
  }

  reportDesc: "Report Descriptor" {
    shape: rectangle
    style: {
      fill: "#bbdefb"
      stroke: "#1976D2"
      font-size: 14
      border-radius: 6
    }
    label: "Report Descriptor\nusbd_custom_hid_if.c\nor bootloader/usb.c\nDefines 4 HID collections"
  }

  usbdClass: "USBD CustomHID + Core" {
    shape: rectangle
    style: {
      fill: "#bbdefb"
      stroke: "#1976D2"
      font-size: 14
      border-radius: 6
    }
    label: "USBD CustomHID + Core\nST middleware\n(app path only)"
  }

  pcd: "HAL PCD + USB FS" {
    shape: rectangle
    style: {
      fill: "#bbdefb"
      stroke: "#1976D2"
      font-size: 14
      border-radius: 6
    }
    label: "HAL PCD + USB FS\nPA11/PA12\n64-byte endpoints"
  }

  appProto -> reportDesc: "Reports" {style: {font-size: 12}}
  reportDesc -> usbdClass: "App path" {style: {font-size: 12}}
  usbdClass -> pcd: "PMA IN 0x98, OUT 0xD8" {style: {font-size: 12}}
}

bus: "USB Full-Speed Bus" {
  shape: rectangle
  style: {
    fill: "#fff9c4"
    stroke: "#F9A825"
    font-size: 14
    border-radius: 6
  }
  label: "USB 1.1 FS\nVID 0483, PID 5750/5751\n1 ms poll, 12 Mbit/s"
}

host: "Host (Windows)" {
  style: {
    fill: "#f3e5f5"
    stroke: "#7B1FA2"
    border-radius: 12
    font-size: 18
    bold: true
  }

  hub: "usbhub + hidusb" {
    shape: rectangle
    style: {
      fill: "#e1bee7"
      stroke: "#8E24AA"
      font-size: 14
      border-radius: 6
    }
    label: "usbhub + hidusb\nInbox drivers\nEnumeration"
  }

  hidclass: "hidclass.sys + hidparse" {
    shape: rectangle
    style: {
      fill: "#e1bee7"
      stroke: "#8E24AA"
      font-size: 14
      border-radius: 6
    }
    label: "hidclass.sys + hidparse\nInbox HID class\nParses descriptor\nRoutes collections"
  }

  kbdmou: "kbdhid / mouhid" {
    shape: rectangle
    style: {
      fill: "#e1bee7"
      stroke: "#8E24AA"
      font-size: 14
      border-radius: 6
    }
    label: "kbdhid / mouhid\nReports 1–2\nKeyboard + Mouse\nConsumer via hidclass"
  }

  userApp: "hidapi in LogicPad.exe" {
    shape: rectangle
    style: {
      fill: "#e1bee7"
      stroke: "#8E24AA"
      font-size: 14
      border-radius: 6
    }
    label: "hidapi in LogicPad.exe\nReport 4 only\nDoes not claim\nkbd/mouse"
  }

  hub -> hidclass: "HID interface" {style: {font-size: 12}}
  hidclass -> kbdmou: "Collections 1–3" {style: {font-size: 12}}
  hidclass -> userApp: "Vendor collection FF00" {style: {font-size: 12}}
}

dev.pcd -> bus: "D+ / D-" {style: {font-size: 12}}
bus -> host.hub: "USB enumeration" {style: {font-size: 12}}
