{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogicPad",
  "mainBinaryName": "LogicPad",
  "version": "0.1.0",
  "identifier": "com.logicpad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LogicPad",
        "width": 1280,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 700,
        "alwaysOnTop": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "LogicPad configurator",
    "longDescription": "Configure LogicPad profiles, keys, macros, lights, and firmware.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "LogicPad"
      }
    }
  }
}
